# Resend (https://resend.com) — used by /api/contact. Without it, dev logs the
# message instead of sending; production answers 503 and the form shows a mailto.
RESEND_API_KEY=

# Where contact form messages are delivered.
CONTACT_TO_EMAIL=contato@cicatriz.dev

# Sender. Until cicatriz.dev is verified in Resend, leave the default
# (onboarding@resend.dev — delivers only to the Resend account owner).
# After verification: CONTACT_FROM_EMAIL="cicatriz.dev <bugs@cicatriz.dev>"
CONTACT_FROM_EMAIL=

# Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# Required in production — without TURNSTILE_SECRET_KEY the form answers 503
# and shows mailto. Dummy keys always pass; use them locally only:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
